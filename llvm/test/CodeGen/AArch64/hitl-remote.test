# CHECK: "baseline_runtime_us": 10.0
# CHECK: "candidate_runtime_us": 9.5
# CHECK: "correct": true
# CHECK: "remote_cpu": 3
# CHECK: "stable": true
# CHECK: "currently_throttled": false
# CHECK: "frequency_khz": 1400000
# CHECK: "temperature_millic": 43000
# CHECK: "throttled": 524288
# UNSTABLE: "stable": false

#--- artifact
mock object

#--- ssh
#!/usr/bin/python3
import json
import sys

command = sys.argv[-1]
if "scaling_cur_freq" in command:
    print("frequency_khz=1400000")
    print("temperature_millic=43000")
    print("throttled=0x80000")
elif "taskset" in command:
    unstable = "unstable" in command
    print(json.dumps({
        "baseline_runtime_us": 10.0,
        "candidate_runtime_us": 9.5,
        "baseline_samples_us": [10.0, 12.0 if unstable else 10.5],
        "candidate_samples_us": [9.5, 9.6],
        "correct": True,
    }))
elif "test -f" in command:
    raise SystemExit(1)
else:
    sys.stdin.buffer.read()
