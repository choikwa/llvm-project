#--- input.ll
; The fake compiler only needs a stable input path.

#--- fake-llc.py
#!/usr/bin/env python3
import json
from pathlib import Path
import sys

args = sys.argv[1:]

def option(name):
    prefix = name + "="
    return next((arg[len(prefix):] for arg in args if arg.startswith(prefix)), None)

output = Path(args[args.index("-o") + 1])
record = Path(option("-amdgpu-prera-training-record-schedule"))
trajectory_text = option("-amdgpu-prera-training-record-trajectory")
replay_text = option("-amdgpu-prera-training-replay-schedule")
seed = option("-amdgpu-prera-training-seed")
if replay_text:
    schedule = Path(replay_text).read_text()
else:
    schedule = "amdgpu-prera-schedule-v1\tkernel\t0\tfingerprint\t0,1,2\n"
if seed:
    schedule = schedule.rstrip() + f"\n# mutation {seed}\n"
record.write_text(schedule)
if trajectory_text:
    Path(trajectory_text).write_text(json.dumps({
        "kind": "state", "role": "founder", "region": 0,
        "order": [0, 1, 2],
    }) + "\n")
output.write_text(schedule)

#--- fake-benchmark.py
#!/usr/bin/env python3
import argparse
import json
from pathlib import Path

parser = argparse.ArgumentParser()
parser.add_argument("--baseline", type=Path, required=True)
parser.add_argument("--candidate", type=Path, required=True)
args = parser.parse_args()
if args.baseline == args.candidate:
    candidate = 100.0
else:
    mutations = args.candidate.read_text().count("# mutation")
    candidate = 90.0 if mutations == 1 else 110.0
print(json.dumps({
    "baseline_runtime_us": 100.0,
    "candidate_runtime_us": candidate,
    "correct": True,
}))
